# Copy to .env and fill in. .env is git-ignored.

# NPS Data API key (used only by scripts/fetch_parks.py, never shipped to the browser).
# Free: https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# ArcGIS location services API key (optional; without it the map uses OpenStreetMap).
# Free developer account: https://location.arcgis.com/sign-up/
# Restrict it to your site's URL in the ArcGIS developer dashboard.
VITE_ARCGIS_API_KEY=
